      "updated": 1742914425079,
      "link": null,
      "locked": false,
      "text": "PostponedConstant doesn't keep its content\nfor the long term, materializes it when\nget_data_ptr() is first called, cache it and\ncan dispose it by request.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PostponedConstant doesn't keep its content\nfor the long term, materializes it when\nget_data_ptr() is first called, cache it and\ncan dispose it by request.",
