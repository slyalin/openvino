      "isDeleted": false,
      "boundElements": [],
      "updated": 1742914425078,
      "link": null,
      "locked": false,
      "text": "For \"per-constant\" handling we need to\nexploit PostponedConstant concept\nbecause the current (GPU) plugin architecture\ndoesn't allow quick extension of transformation\nflow to materialize Decomposition Subgraph and\nrepack weights to HW layout in one shot.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For \"per-constant\" handling we need to\nexploit PostponedConstant concept\nbecause the current (GPU) plugin architecture\ndoesn't allow quick extension of transformation\nflow to materialize Decomposition Subgraph and\nrepack weights to HW layout in one shot.",
      "autoResize": true,
      "lineHeight": 1.25
    },
