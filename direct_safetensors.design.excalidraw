    {
      "id": "SeWvAtRMjNHPRPW7zD2hE",
      "type": "text",
      "x": 3280.5505473081785,
      "y": 1431.5439052894333,
      "width": 681.8194580078125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3H",
      "roundness": null,
      "seed": 581257820,
      "version": 794,
      "versionNonce": 1847460321,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1742912984836,
      "link": null,
      "locked": false,
      "text": "Can IR have a reference to exactly that safetensors file(s)\nthat was used during the conversion?\n\nIt would allow loading IR with ExternalConstant without\nspecifying an additional External Data argument on the same machine,\nwhich makes `read_model` experience the same as before.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Can IR have a reference to exactly that safetensors file(s)\nthat was used during the conversion?\n\nIt would allow loading IR with ExternalConstant without\nspecifying an additional External Data argument on the same machine,\nwhich makes `read_model` experience the same as before.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7hIsDxj0Ix7fFcLP8TN9O",
      "type": "text",
      "x": 5163.538416272417,
      "y": 459.22481356521484,
      "width": 323.5998229980469,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3I",
      "roundness": null,
      "seed": 16630236,
      "version": 388,
      "versionNonce": 2054503396,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "N6kG4qKRJP1aKzUsSBydf",
          "type": "arrow"
        }
      ],
      "updated": 1742914425078,
      "link": null,
      "locked": false,
      "text": "That's the main reason why\ndecomposition is postponed to\ncompile_model and is not done at\nlink_model time.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "That's the main reason why\ndecomposition is postponed to\ncompile_model and is not done at\nlink_model time.",
      "autoResize": true,
      "lineHeight": 1.25
    },
