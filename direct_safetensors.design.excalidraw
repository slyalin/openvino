      "updated": 1743079000517,
      "link": null,
      "locked": false,
      "text": "The assumption is that tensor names, shapes, and data types from\na given safetensors file should be enough to detect which type of\nquantization is used.\n\nIf that assumption is not satisfied, then a hint to interpret the content\nmay be required to pass to link_model.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The assumption is that tensor names, shapes, and data types from\na given safetensors file should be enough to detect which type of\nquantization is used.\n\nIf that assumption is not satisfied, then a hint to interpret the content\nmay be required to pass to link_model.",
      "autoResize": true,
      "lineHeight": 1.25
    },
