          "type": "arrow"
        }
      ],
      "updated": 1742914425078,
      "link": null,
      "locked": false,
      "text": "Another reason: read_model is\nnot supposed to be where\ntransformations take place.\nIt is a model deserialization\nonly.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Another reason: read_model is\nnot supposed to be where\ntransformations take place.\nIt is a model deserialization\nonly.",
      "autoResize": true,
      "lineHeight": 1.25
    },
