    {
      "id": "Vk2HezQ-iPGWPxLiL0ct8",
      "type": "text",
      "x": 4443.83477485548,
      "y": 399.520336458615,
      "width": 626.3877563476562,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3E",
      "roundness": null,
      "seed": 1566849884,
      "version": 1288,
      "versionNonce": 180284772,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "Xjmgqmnp3kvHYPvwbDz9_",
          "type": "arrow"
        }
      ],
      "updated": 1742915863895,
      "link": null,
      "locked": false,
      "text": "Decomposition may need to temporary\nrepack original safetensors' layout\nto OpenVINO HW independent layout\nbefore repacking to the HW-dependent layout.\nIt can be done per-constant to save\nmemory on temporary weights storage.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Decomposition may need to temporary\nrepack original safetensors' layout\nto OpenVINO HW independent layout\nbefore repacking to the HW-dependent layout.\nIt can be done per-constant to save\nmemory on temporary weights storage.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-x01CKsaG7dP494F3sRup",
      "type": "arrow",
      "x": 4452.778152043358,
      "y": 823.7463405183373,
      "width": 93.7286229452111,
      "height": 88.63464828802603,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
